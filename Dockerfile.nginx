
# PHP build stage
FROM php:8.4.27-fpm AS builder

WORKDIR /var/www

# UPDATE 1: PHP system package upgrade
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        libicu-dev \
    && docker-php-ext-install -j"$(nproc)" intl \
    && rm -rf /var/lib/apt/lists/*

# UPDATE 2: PHP dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libxpm-dev \
    fcgiwrap \
    libmcrypt-dev \
    libwebp-dev \
    libxml2-dev \
    locales \
    zip \
    jpegoptim optipng pngquant gifsicle \
    vim \
    unzip \
    git \
    bash \
    curl \
    libzip-dev \
    libpq-dev \
    libonig-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" gd \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-install pdo pdo_mysql mbstring zip exif pcntl bcmath opcache sockets

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

COPY . /var/www

RUN composer install --no-dev --optimize-autoloader

RUN chown -R www-data:www-data /var/www

RUN chmod -R 755 /var/www/storage


# UPDATE 3: Nginx production stage
FROM nginxinc/nginx-unprivileged:alpine

USER root

# Upgrade all Alpine packages to available patched versions
RUN apk update \
    && apk upgrade --no-cache \
    && apk info -v curl libcurl libexpat libxslt musl musl-utils zlib \
    && apk list -I | grep -E '^(curl|libcurl|expat|libexpat|libxslt|musl|musl-utils|zlib)-'

WORKDIR /var/www/

COPY --from=builder --chown=nginx:nginx /var/www .

COPY ./server/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

# Run Nginx as a non-root user
USER nginx

CMD ["nginx", "-g", "daemon off;"]
